CLIMAFORGE_ENV=development
CLIMAFORGE_DEBUG=True
CLIMAFORGE_HOST=0.0.0.0
CLIMAFORGE_PORT=8000
CLIMAFORGE_CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]

# Nugen AI Conversational Assistant (Advisory AI Layer)
# Set NUGEN_ENABLED=True, NUGEN_MOCK_MODE=False, NUGEN_PROVIDER=nugen to enable live inference.
NUGEN_ENABLED=False
NUGEN_MOCK_MODE=True
NUGEN_PROVIDER=mock
NUGEN_API_KEY=
NUGEN_API_URL=https://api.nugen.in/api/v3/inference/chat/completions
NUGEN_MODEL=Qwen/Qwen2.5-0.5B-Instruct
NUGEN_MAX_TOKENS=500
NUGEN_TEMPERATURE=0.1
NUGEN_STREAM=true
NUGEN_TIMEOUT_SECONDS=25.0

# Grounded M15 Chatbot (optional OpenAI-compatible provider)
# Leave CHATBOT_PROVIDER=none or NUGEN_PROVIDER=mock for offline deterministic operation.
CHATBOT_PROVIDER=none
CHATBOT_API_KEY=
CHATBOT_ENDPOINT=
CHATBOT_MODEL=
CHATBOT_TIMEOUT_SECONDS=20.0

# Real-Time Environmental Intelligence & IMD (optional official IMD credentials)
# Default is Open-Meteo for live weather and precipitation forecasts.
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1
OPEN_METEO_TIMEOUT_SECONDS=10.0
WEATHER_CACHE_TTL_SECONDS=600
IMD_ENABLED=false
IMD_API_BASE_URL=https://api.imd.gov.in/public
IMD_API_KEY=
IMD_TIMEOUT_SECONDS=10.0

# Authentication (replace both secret placeholders with different random values)
AUTH_MODE=strict
JWT_SIGNING_KEY=replace-with-a-random-secret-at-least-32-bytes
JWT_ALGORITHM=HS256
JWT_ISSUER=climaforge
JWT_AUDIENCE=climaforge-api
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
REFRESH_TOKEN_PEPPER=replace-with-a-different-random-secret-at-least-32-bytes
DATABASE_URL=sqlite:///./climaforge.db
